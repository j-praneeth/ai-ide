# ── Relay Configuration (Admin Only) ──────────────────────────────────
# Set these before building/deploying the desktop app.
# Users will never see these values.

# Your deployed relay server URL (e.g. Railway deployment)
RELAY_URL=https://your-relay.up.railway.app

# The secret key matching RELAY_SECRET on the relay server
RELAY_SECRET=your-secret-key-here

# Auto-connect to relay on startup (default: true)
RELAY_AUTO_CONNECT=true